{
  "_comment": "Full Phase 1 + Phase 2 + Phase 2+ experiment matrix. 100 samples per run.",

  "global": {
    "limit":        100,
    "seed":         42,
    "target_model": "Qwen/Qwen3-8B",
    "eagle3_model": "RedHatAI/Qwen3-8B-speculator.eagle3",
    "results_dir":  "/fsx/jmanvi/Internship_project/ASD/results/Runs/Phase2",
    "data_dir":     "/fsx/jmanvi/Internship_project/ASD/data/benchmarks/By_split_phase_1"
  },

  "workload_files": {
    "code_gen":                      "code_gen_test.jsonl",
    "conversational_generation_gen": "conversational_generation_test_gen.jsonl",
    "conversational_generation_sft": "conversational_generation_test_sft.jsonl",
    "hardware_gen":                  "hardware_gen_test.jsonl",
    "long_chain_reasoning":          "long_chain_reasoning.jsonl",
    "long_context_completion":       "long_context_completion.jsonl",
    "long_horizon_swe":              "long_horizon_swe_test.jsonl",
    "mathematical_reasoning":        "mathematical_reasoning_test.jsonl"
  },

  "_workload_files_notes": {
    "long_chain_reasoning":    " MATH/GPQA",
    "long_context_completion": "bigcode/the-stack-smol (Python) via updated prepare_prompts.py — replaces synthetic fallback. Re-run prepare_prompts before experiments.",
    "all_others":              "real datasets, loaded successfully in Phase 1"
  },

  "workload_max_tokens": {
    "code_gen":                      512,
    "conversational_generation_gen": 512,
    "conversational_generation_sft": 512,
    "hardware_gen":                  512,
    "long_chain_reasoning":          1024,
    "long_context_completion":       2048,
    "long_horizon_swe":              1024,
    "mathematical_reasoning":        512
  },

  "_workload_max_tokens_notes": {
    "long_context_completion": "2048 — real code files require longer generation budget than synthetic prompts had",
    "long_chain_reasoning":    "1024 — will increase to 2048 when real MATH/GPQA data available"
  },
    "_draft_model_policy": {
    "default": "Qwen/Qwen3-0.6B — smallest family-aligned draft, used in all experiments except D",
    "D_sweep": "Qwen/Qwen2.5-1.5B-Instruct (mismatch baseline) + Qwen3-0.6B/1.7B/4B (family sweep)",
    "rationale": "Using Qwen2.5 as default draft produces 0.5x AR (Phase 1 finding). Qwen3-0.6B is the correct default for meaningful k-sensitivity and regime analysis."
  },

  "experiments": [

    {
      "name":        "A_baseline_sweep",
      "phase":       1,
      "description": "Core baseline: all workloads x all 4 methods at k=4, T=0.0",
      "workloads":   "all",
      "configs": [
        {"method": "ar",       "k": 1, "temperature": 0.0},
        {"method": "ngram_sd", "k": 4, "temperature": 0.0, "ngram_lookup_min": 1, "ngram_lookup_max": 4},
        {"method": "draft_sd", "k": 4, "temperature": 0.0, "draft_model": "Qwen/Qwen3-0.6B"},
        {"method": "eagle3",   "k": 4, "temperature": 0.0}
      ]
    },

    {
      "name":        "B_k_sweep",
      "phase":       1,
      "description": "k sensitivity: k in {1,2,4,8,16} for all speculative methods",
      "workloads":   "all",
      "configs": [
        {"method": "ngram_sd", "k": 1,  "temperature": 0.0, "ngram_lookup_min": 1, "ngram_lookup_max": 4},
        {"method": "ngram_sd", "k": 2,  "temperature": 0.0, "ngram_lookup_min": 1, "ngram_lookup_max": 4},
        {"method": "ngram_sd", "k": 8,  "temperature": 0.0, "ngram_lookup_min": 1, "ngram_lookup_max": 4},
        {"method": "ngram_sd", "k": 16, "temperature": 0.0, "ngram_lookup_min": 1, "ngram_lookup_max": 4},
        {"method": "draft_sd", "k": 1,  "temperature": 0.0, "draft_model": "Qwen/Qwen3-0.6B"},
        {"method": "draft_sd", "k": 2,  "temperature": 0.0, "draft_model": "Qwen/Qwen3-0.6B"},
        {"method": "draft_sd", "k": 8,  "temperature": 0.0, "draft_model": "Qwen/Qwen3-0.6B"},
        {"method": "draft_sd", "k": 16, "temperature": 0.0, "draft_model": "Qwen/Qwen3-0.6B"},
        {"method": "eagle3",   "k": 1,  "temperature": 0.0},
        {"method": "eagle3",   "k": 2,  "temperature": 0.0},
        {"method": "eagle3",   "k": 8,  "temperature": 0.0},
        {"method": "eagle3",   "k": 16, "temperature": 0.0}
      ]
    },

    {
      "name":        "C_ngram_config_sweep",
      "phase":       2,
      "description": "Ngram lookup window sensitivity — 4 representative workloads",
      "workloads":   ["code_gen", "mathematical_reasoning", "long_chain_reasoning", "conversational_generation_sft"],
      "configs": [
        {"method": "ngram_sd", "k": 4, "temperature": 0.0, "ngram_lookup_min": 1, "ngram_lookup_max": 4},
        {"method": "ngram_sd", "k": 4, "temperature": 0.0, "ngram_lookup_min": 2, "ngram_lookup_max": 8},
        {"method": "ngram_sd", "k": 4, "temperature": 0.0, "ngram_lookup_min": 2, "ngram_lookup_max": 16},
        {"method": "ngram_sd", "k": 8, "temperature": 0.0, "ngram_lookup_min": 2, "ngram_lookup_max": 8},
        {"method": "ngram_sd", "k": 8, "temperature": 0.0, "ngram_lookup_min": 4, "ngram_lookup_max": 16},
        {"method": "ngram_sd", "k": 8, "temperature": 0.0, "ngram_lookup_min": 4, "ngram_lookup_max": 32}
      ]
    },

    {
      "name":        "D_draft_model_sweep",
      "phase":       2,
      "description": "Qwen3 draft family: 0.6B / 1.7B / 4B — plus mismatched Qwen2.5 baseline",
      "workloads":   ["code_gen", "mathematical_reasoning", "long_chain_reasoning"],
      "_note":       "Only Qwen3-4B ran in original Phase 2. 0.6B and 1.7B are new additions.",
      "configs": [
        {"method": "draft_sd", "k": 4, "temperature": 0.0, "draft_model": "Qwen/Qwen2.5-1.5B-Instruct"},
        {"method": "draft_sd", "k": 4, "temperature": 0.0, "draft_model": "Qwen/Qwen3-0.6B"},
        {"method": "draft_sd", "k": 4, "temperature": 0.0, "draft_model": "Qwen/Qwen3-1.7B"},
        {"method": "draft_sd", "k": 4, "temperature": 0.0, "draft_model": "Qwen/Qwen3-4B"},
        {"method": "draft_sd", "k": 8, "temperature": 0.0, "draft_model": "Qwen/Qwen2.5-1.5B-Instruct"},
        {"method": "draft_sd", "k": 8, "temperature": 0.0, "draft_model": "Qwen/Qwen3-0.6B"},
        {"method": "draft_sd", "k": 8, "temperature": 0.0, "draft_model": "Qwen/Qwen3-1.7B"},
        {"method": "draft_sd", "k": 8, "temperature": 0.0, "draft_model": "Qwen/Qwen3-4B"}
      ]
    },

    {
      "name":        "E_temperature_sweep",
      "phase":       2,
      "description": "Temperature effect — all 4 methods including draft_sd (previously missing)",
      "workloads":   "all",
      "_note":       "draft_sd added. Shows mismatch penalty is temperature-invariant (expected null result).",
      "configs": [
        {"method": "ar",       "k": 1, "temperature": 0.3},
        {"method": "ar",       "k": 1, "temperature": 0.6},
        {"method": "ar",       "k": 1, "temperature": 1.0},
        {"method": "ngram_sd", "k": 4, "temperature": 0.3, "ngram_lookup_min": 1, "ngram_lookup_max": 4},
        {"method": "ngram_sd", "k": 4, "temperature": 0.6, "ngram_lookup_min": 1, "ngram_lookup_max": 4},
        {"method": "ngram_sd", "k": 4, "temperature": 1.0, "ngram_lookup_min": 1, "ngram_lookup_max": 4},
        {"method": "draft_sd", "k": 4, "temperature": 0.3, "draft_model": "Qwen/Qwen3-0.6B"},
        {"method": "draft_sd", "k": 4, "temperature": 0.6, "draft_model": "Qwen/Qwen3-0.6B"},
        {"method": "draft_sd", "k": 4, "temperature": 1.0, "draft_model": "Qwen/Qwen3-0.6B"},
        {"method": "eagle3",   "k": 4, "temperature": 0.3},
        {"method": "eagle3",   "k": 4, "temperature": 0.6},
        {"method": "eagle3",   "k": 4, "temperature": 1.0}
      ]
    },

    {
      "name":        "F_context_growth",
      "phase":       2,
      "description": "Context length scaling — all 4 methods including draft_sd (previously missing)",
      "workloads":   "all",
      "_note":       "draft_sd added. Hypothesis: mismatch unaffected by context length (distributional not coverage-based).",
      "context_lengths": [64, 128, 256, 512, 1024],
      "configs": [
        {"method": "ar",       "k": 1, "temperature": 0.0},
        {"method": "ngram_sd", "k": 4, "temperature": 0.0, "ngram_lookup_min": 1, "ngram_lookup_max": 4},
        {"method": "draft_sd", "k": 4, "temperature": 0.0, "draft_model": "Qwen/Qwen3-0.6B"},
        {"method": "eagle3",   "k": 4, "temperature": 0.0}
      ]
    },

    {
      "name":        "G_multi_turn",
      "phase":       2,
      "description": "Multi-turn depth — all 4 methods including draft_sd (previously missing)",
      "workloads":   ["conversational_generation_gen", "conversational_generation_sft"],
      "_note":       "draft_sd added. Richer context does not help mismatched draft.",
      "turn_depths": [2, 4, 8],
      "configs": [
        {"method": "ar",       "k": 1, "temperature": 0.0},
        {"method": "ngram_sd", "k": 4, "temperature": 0.0, "ngram_lookup_min": 1, "ngram_lookup_max": 4},
        {"method": "draft_sd", "k": 4, "temperature": 0.0, "draft_model": "Qwen/Qwen3-0.6B"},
        {"method": "eagle3",   "k": 4, "temperature": 0.0}
      ]
    },

    {
      "name":        "H_oracle_k_study",
      "phase":       "2+",
      "description": "Oracle k: run all k values per prompt to find retrospective optimum. Feeds adaptive controller design.",
      "workloads":   "all",
      "configs": [
        {"method": "eagle3",   "k": 1,  "temperature": 0.0},
        {"method": "eagle3",   "k": 2,  "temperature": 0.0},
        {"method": "eagle3",   "k": 4,  "temperature": 0.0},
        {"method": "eagle3",   "k": 8,  "temperature": 0.0},
        {"method": "eagle3",   "k": 16, "temperature": 0.0},
        {"method": "ngram_sd", "k": 1,  "temperature": 0.0, "ngram_lookup_min": 1, "ngram_lookup_max": 4},
        {"method": "ngram_sd", "k": 2,  "temperature": 0.0, "ngram_lookup_min": 1, "ngram_lookup_max": 4},
        {"method": "ngram_sd", "k": 4,  "temperature": 0.0, "ngram_lookup_min": 1, "ngram_lookup_max": 4},
        {"method": "ngram_sd", "k": 8,  "temperature": 0.0, "ngram_lookup_min": 1, "ngram_lookup_max": 4},
        {"method": "ngram_sd", "k": 16, "temperature": 0.0, "ngram_lookup_min": 1, "ngram_lookup_max": 4}
      ]
    },

    {
      "name":        "I_entropy_bucket_study",
      "phase":       "2+",
      "description": "Entropy-stratified speedup: entropy_bucket column tags each row low/medium/high for post-hoc analysis",
      "workloads":   "all",
      "_note":       "entropy_bucket is now auto-computed in run_benchmark.py. This experiment runs the standard sweep so aggregate_results.py can pivot by bucket.",
      "configs": [
        {"method": "ar",       "k": 1,  "temperature": 0.0},
        {"method": "ngram_sd", "k": 4,  "temperature": 0.0, "ngram_lookup_min": 1, "ngram_lookup_max": 4},
        {"method": "ngram_sd", "k": 8,  "temperature": 0.0, "ngram_lookup_min": 1, "ngram_lookup_max": 4},
        {"method": "ngram_sd", "k": 16, "temperature": 0.0, "ngram_lookup_min": 1, "ngram_lookup_max": 4},
        {"method": "draft_sd", "k": 4,  "temperature": 0.0, "draft_model": "Qwen/Qwen3-0.6B"},
        {"method": "draft_sd", "k": 8,  "temperature": 0.0, "draft_model": "Qwen/Qwen3-0.6B"},
        {"method": "draft_sd", "k": 16,  "temperature": 0.0, "draft_model": "Qwen/Qwen3-0.6B"},
        {"method": "eagle3",   "k": 4,  "temperature": 0.0},
        {"method": "eagle3",   "k": 8,  "temperature": 0.0},
        {"method": "eagle3",   "k": 16, "temperature": 0.0}
      ]
    },

    {
      "name":        "J_intra_sequence_transition",
      "phase":       "2+",
      "description": "Intra-sequence entropy window analysis — long-output workloads only",
      "_note":       "entropy_w0/w1/w2 and entropy_trend auto-computed in run_benchmark.py. Long workloads show visible regime transitions.",
      "workloads":   ["long_chain_reasoning", "long_context_completion", "long_horizon_swe", "mathematical_reasoning"],
      "configs": [
        {"method": "ar",       "k": 1,  "temperature": 0.0},
        {"method": "ngram_sd", "k": 4,  "temperature": 0.0, "ngram_lookup_min": 1, "ngram_lookup_max": 4},
        {"method": "ngram_sd", "k": 16, "temperature": 0.0, "ngram_lookup_min": 1, "ngram_lookup_max": 4},
        {"method": "eagle3",   "k": 4,  "temperature": 0.0},
        {"method": "eagle3",   "k": 16, "temperature": 0.0}
      ]
    },

    {
      "name":        "K_rejection_study",
      "phase":       "2+",
      "description": "Rejection characterization: concentration, severity, first_rejection_pos, decay slope across k and temperature",
      "_note":       "All 6 rejection metrics auto-computed in run_benchmark.py. Key question: do rejections cluster or spread uniformly?",
      "workloads":   "all",
      "configs": [
        {"method": "eagle3",   "k": 2,  "temperature": 0.0},
        {"method": "eagle3",   "k": 4,  "temperature": 0.0},
        {"method": "eagle3",   "k": 8,  "temperature": 0.0},
        {"method": "eagle3",   "k": 16, "temperature": 0.0},
        {"method": "eagle3",   "k": 4,  "temperature": 0.6},
        {"method": "ngram_sd", "k": 2,  "temperature": 0.0, "ngram_lookup_min": 1, "ngram_lookup_max": 4},
        {"method": "ngram_sd", "k": 4,  "temperature": 0.0, "ngram_lookup_min": 1, "ngram_lookup_max": 4},
        {"method": "ngram_sd", "k": 8,  "temperature": 0.0, "ngram_lookup_min": 1, "ngram_lookup_max": 4},
        {"method": "ngram_sd", "k": 16, "temperature": 0.0, "ngram_lookup_min": 1, "ngram_lookup_max": 4},
        {"method": "ngram_sd", "k": 4,  "temperature": 0.6, "ngram_lookup_min": 1, "ngram_lookup_max": 4},
        {"method": "draft_sd", "k": 2,  "temperature": 0.0, "draft_model": "Qwen/Qwen3-0.6B"},
        {"method": "draft_sd", "k": 4,  "temperature": 0.0, "draft_model": "Qwen/Qwen3-0.6B"},
        {"method": "draft_sd", "k": 8,  "temperature": 0.0, "draft_model": "Qwen/Qwen3-0.6B"},
        {"method": "draft_sd", "k": 16,  "temperature": 0.0, "draft_model": "Qwen/Qwen3-0.6B"}
      ]
    }

  ]
}